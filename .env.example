# Copy to .env (never committed) and set a long random password:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Host port for local runs (127.0.0.1 only).
PARATRACK_PORT=8000

# Optional: nightly dump to S3-compatible storage (scripts/backup-s3.sh + cron).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY_ID=
S3_SECRET_KEY=

# Optional: Sentry error reporting for the web server. Empty = off.
PARATRACK_SENTRY_DSN=
PARATRACK_SENTRY_TRACES=1.0

# Optional mail (invoices to clients, team invites, password reset).
# Empty = letters go to the server log. Host with port, e.g. smtp.yandex.ru:465
# PARATRACK_SMTP_HOST=
# PARATRACK_SMTP_USER=
# PARATRACK_SMTP_PASS=
# PARATRACK_MAIL_FROM=paratrack@example.com

# Optional single sign-on (OIDC): issuer URL, client id and secret.
# Callback to register at the IdP: https://<your host>/sso/callback
# PARATRACK_OIDC_ISSUER=
# PARATRACK_OIDC_CLIENT_ID=
# PARATRACK_OIDC_CLIENT_SECRET=

# Optional integration switches:
# PARATRACK_STRIPE_WEBHOOK_SECRET=whsec_…   # fallback when a workspace has none
# PARATRACK_WEBHOOK_ALLOW_PRIVATE=1         # let outbound webhooks reach LAN/localhost (self-host)
# PARATRACK_OIDC_TRUST_EMAIL=1              # IdP that omits email_verified but verifies emails
# PARATRACK_JIRA_SITE=https://acme.atlassian.net  # default Jira site; a target may name its own

# Encrypts integration tokens, Stripe keys and webhook secrets at rest
# (AES-256-GCM). Keep a copy: without it those secrets must be re-entered.
#   openssl rand -hex 32
PARATRACK_SECRET_KEY=

# Fallback time zone before a browser reports its own (IANA name).
PARATRACK_TZ=Europe/Moscow
