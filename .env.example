# Copy to .env (never committed) and set a long random password:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Host port for local runs (127.0.0.1 only).
PARATRACK_PORT=8000

# Optional: nightly dump to S3-compatible storage (scripts/backup-s3.sh + cron).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY_ID=
S3_SECRET_KEY=

# Optional: Sentry error reporting for the web server. Empty = off.
PARATRACK_SENTRY_DSN=
PARATRACK_SENTRY_TRACES=1.0
