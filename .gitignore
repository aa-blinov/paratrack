# build artefacts
/paratrack
/paratrack-web

# macOS noise
.DS_Store
**/.DS_Store

# test cookies / local data
/.audit-cookies.txt
/.audit-cookies.*

# screenshots / helper scripts aren't part of the app
/e2e/__pycache__/
/e2e/audit*_*.mjs
/e2e/audit*_*.py

# node helper for screenshot tooling
/node_modules/
/web/node_modules/

# never commit screenshot artefacts (regen with /e2e/audit*.py)
/e2e/screenshots/audit-*.png
/e2e/screenshots/native-*.png
/e2e/screenshots/mobile-*.png
/e2e/screenshots/graph-*.png
/e2e/screenshots/echart-*.png
/e2e/screenshots/clients-*.png
/e2e/screenshots/client-detail.png
/e2e/screenshots/prod-*.png
/e2e/screenshots/seed-demo*.png
/e2e/screenshots/demo-overbudget.png
/e2e/screenshots/demo-*.png
/e2e/screenshots/project-*.png

# local compose data
/data/

# compose secrets
/.env
/docker-compose.override.yml

# impeccable review captures and critique drafts (local)
/.impeccable/review/
/.impeccable/critique/

# Windows build artefacts (qa-env rebuild keeps a backup beside the exe)
/paratrack.exe
/paratrack.exe~
e2e-server-err.log

# Runtime logs of local e2e stands
e2e-server.log

# Python bytecode of local tooling
__pycache__/

# Ревизии ЦА: улики ревьюеров не грузим в репозиторий
e2e/screenshots/rev-*/
