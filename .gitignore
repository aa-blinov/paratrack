# build artefacts
/paratrack
/paratrack-web
/internal/web/static/ui/
/.venv/

# macOS noise
.DS_Store
**/.DS_Store

# test cookies / local data
/.audit-cookies.txt
/.audit-cookies.*

# screenshots / helper scripts aren't part of the app
/e2e/__pycache__/
/e2e/audit*_*.mjs
/e2e/audit*_*.py

# node helper for screenshot tooling
/node_modules/
/web/node_modules/

# never commit screenshot artefacts (regen with /e2e/audit*.py)
/e2e/screenshots/

# local compose data
/data/

# compose secrets
/.env
/docker-compose.override.yml

# impeccable review captures and critique drafts (local)
/.impeccable/review/
/.impeccable/critique/

# Windows build artefacts (qa-env rebuild keeps a backup beside the exe)
/paratrack.exe
/paratrack.exe~
e2e-server-err.log

# Runtime logs of local e2e stands
e2e-server.log

# Python bytecode of local tooling
__pycache__/
