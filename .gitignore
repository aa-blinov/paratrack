# build artefacts
/paratrack
/paratrack-web

# macOS noise
.DS_Store
**/.DS_Store

# test cookies / local data
/.audit-cookies.txt
/.audit-cookies.*

# screenshots / helper scripts aren't part of the app
/e2e/__pycache__/
/e2e/audit*_*.mjs
/e2e/audit*_*.py

# node helper for screenshot tooling
/node_modules/
/web/node_modules/

# never commit screenshot artefacts (regen with /e2e/audit*.py)
/e2e/screenshots/audit-*.png
/e2e/screenshots/native-*.png
/e2e/screenshots/mobile-*.png
/e2e/screenshots/graph-*.png
/e2e/screenshots/echart-*.png
