{
  "name": "paratrack-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "paratrack UI source — React and shadcn/ui application with Go-rendered fragments",
  "scripts": {
    "build": "npm run build:legacy && npm run build:react",
    "build:legacy": "tailwindcss -i ./input.css -o ../internal/web/static/css/paratrack.css --minify",
    "build:react": "vite build && tailwindcss -i ./src/ui.css -o ../internal/web/static/ui/app.css --minify && node ./scripts/scope-react-css.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src/**/*.test.ts",
    "check:js": "for f in ../internal/web/static/js/app*.js; do node --check \"$f\" || exit 1; done && cd .. && eslint --config eslint.config.js internal/web/static/js/app*.js && cd web && node ./scripts/check-js-imports.mjs && npm audit",
    "test:js": "node --test ./scripts/*.test.mjs",
    "watch": "tailwindcss -i ./input.css -o ../internal/web/static/css/paratrack.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.43",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "^2.6.0"
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
