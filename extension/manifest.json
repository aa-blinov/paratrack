{
  "manifest_version": 3,
  "name": "paratrack",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://paratrack.duckdns.org/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "paratrack"
  },
  "icons": {
    "128": "icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "default_locale": "ru",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
