{
  "manifest_version": 3,
  "name": "paratrack",
  "version": "0.1.0",
  "description": "Start and stop paratrack timers from any tab.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://paratrack.duckdns.org/*", "http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "paratrack"
  },
  "icons": {
    "128": "icon128.png"
  }
}
